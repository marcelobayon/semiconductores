# ---------------------------------------------------------------------------
# Semiconductores.net — environment variables (names + descriptions only)
# Copy to .env.local for development. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap, hreflang). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://semiconductores.net

# GA4-direct measurement ID. Analytics only loads when this is set, so leave it
# UNSET in preview/branch deploys and set it ONLY in the production context so
# preview traffic never pollutes the real property. (GTM is deferred to the
# Portfolio Intelligence milestone.)
NEXT_PUBLIC_GA_ID=G-NYC1V06H6X

# Resend transactional email (SERVER-SIDE ONLY — never prefix with NEXT_PUBLIC).
# Leave blank until domain control + SPF/DKIM/DMARC are verified.
RESEND_API_KEY=

# Address that inquiry/sourcing notifications are sent to.
CONTACT_INBOX=
